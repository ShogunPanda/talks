{
  "name": "talks",
  "version": "1.0.0",
  "description": "Public Tech Talks",
  "homepage": "https://github.com/ShogunPanda/talks",
  "repository": "https://github.com/ShogunPanda/talks",
  "bugs": {
    "url": "https://github.com/ShogunPanda/talks/issues"
  },
  "author": "Shogun <shogun@cowtech.it>",
  "license": "Apache-2.0",
  "licenses": [
    {
      "type": "Apache-2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "freya development",
    "build": "freya build",
    "postbuild1": "npm run lint && npm run lint:css && tsc -p . --noEmit",
    "server": "freya server",
    "pdf": "freya pdf",
    "format": "prettier -w src",
    "lint": "eslint --cache",
    "lint:css": "stylelint --cache src/**/*.css",
    "deploy": "freya deploy",
    "postdeploy": "freya postdeploy && cd dist/deploy && netlify deploy --site $NETLIFY_SITE_ID --dir site --prod",
    "list": "find src/talks -type d -depth 1 -exec basename {} \\; | sort",
    "fix-downloads-visibility": "nodemon -e jpg,png,webp --exec chflags nohidden .",
    "generate-cfp": "freya generate-cfp"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@perseveranza-pets/dante": "^2.1.2",
    "@perseveranza-pets/freya": "^1.1.1"
  },
  "devDependencies": {
    "@cowtech/eslint-config": "^12.0.1",
    "@cowtech/stylelint-config": "^3.0.0",
    "@cowtech/typescript-config": "^1.0.0",
    "@eslint/compat": "^2.1.1",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "pino": "^10.3.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
